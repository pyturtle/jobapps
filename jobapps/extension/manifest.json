{
  "manifest_version": 3,
  "name": "JobApps Autofill",
  "version": "1.4.0",
  "description": "Fills job applications with the answers on your JobApps home server. Never submits for you.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://*.greenhouse.io/*",
    "https://jobs.lever.co/*",
    "https://jobs.eu.lever.co/*",
    "https://jobs.ashbyhq.com/*",
    "https://*.myworkdayjobs.com/*",
    "https://*.myworkdaysite.com/*",
    "https://*.smartrecruiters.com/*",
    "https://jobs.smartrecruiters.com/*",
    "https://apply.workable.com/*",
    "https://jobs.workable.com/*",
    "https://*.icims.com/*",
    "https://*.jibeapply.com/*",
    "https://*.taleo.net/*",
    "https://*.successfactors.com/*",
    "https://*.successfactors.eu/*",
    "https://*.sapsf.com/*",
    "https://*.sapsf.eu/*",
    "https://*.oraclecloud.com/*",
    "https://*.jobvite.com/*",
    "https://*.bamboohr.com/*",
    "https://*.breezy.hr/*",
    "https://*.recruitee.com/*",
    "https://*.teamtailor.com/*",
    "https://ats.rippling.com/*",
    "https://*.rippling-ats.com/*",
    "https://*.dayforcehcm.com/*",
    "https://*.ultipro.com/*",
    "https://*.ultipro.ca/*",
    "https://*.rec.pro.ukg.net/*",
    "https://*.paylocity.com/*",
    "https://*.paycomonline.net/*",
    "https://workforcenow.adp.com/*",
    "https://myjobs.adp.com/*",
    "https://recruiting.adp.com/*",
    "https://*.eightfold.ai/*",
    "https://*.phenompeople.com/*",
    "https://*.avature.net/*",
    "https://*.applytojob.com/*",
    "https://*.pinpointhq.com/*",
    "https://*.brassring.com/*",
    "https://*.csod.com/*",
    "https://*.comeet.com/*",
    "https://*.comeet.co/*",
    "https://*.jobs.personio.de/*",
    "https://*.jobs.personio.com/*",
    "https://jobs.gem.com/*",
    "https://app.dover.com/*",
    "https://jobs.polymer.co/*",
    "https://app.trinethire.com/*",
    "https://*.freshteam.com/*",
    "https://careers.jobscore.com/*",
    "https://*.recruitingbypaycor.com/*",
    "https://*.pageuppeople.com/*",
    "https://*.tal.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "JobApps",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "commands": {
    "fill": {
      "suggested_key": {
        "default": "Alt+J",
        "mac": "Alt+J"
      },
      "description": "Fill this application"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.greenhouse.io/*",
        "https://jobs.lever.co/*",
        "https://jobs.eu.lever.co/*",
        "https://jobs.ashbyhq.com/*",
        "https://*.myworkdayjobs.com/*",
        "https://*.myworkdaysite.com/*",
        "https://*.smartrecruiters.com/*",
        "https://jobs.smartrecruiters.com/*",
        "https://apply.workable.com/*",
        "https://jobs.workable.com/*",
        "https://*.icims.com/*",
        "https://*.jibeapply.com/*",
        "https://*.taleo.net/*",
        "https://*.successfactors.com/*",
        "https://*.successfactors.eu/*",
        "https://*.sapsf.com/*",
        "https://*.sapsf.eu/*",
        "https://*.oraclecloud.com/*",
        "https://*.jobvite.com/*",
        "https://*.bamboohr.com/*",
        "https://*.breezy.hr/*",
        "https://*.recruitee.com/*",
        "https://*.teamtailor.com/*",
        "https://ats.rippling.com/*",
        "https://*.rippling-ats.com/*",
        "https://*.dayforcehcm.com/*",
        "https://*.ultipro.com/*",
        "https://*.ultipro.ca/*",
        "https://*.rec.pro.ukg.net/*",
        "https://*.paylocity.com/*",
        "https://*.paycomonline.net/*",
        "https://workforcenow.adp.com/*",
        "https://myjobs.adp.com/*",
        "https://recruiting.adp.com/*",
        "https://*.eightfold.ai/*",
        "https://*.phenompeople.com/*",
        "https://*.avature.net/*",
        "https://*.applytojob.com/*",
        "https://*.pinpointhq.com/*",
        "https://*.brassring.com/*",
        "https://*.csod.com/*",
        "https://*.comeet.com/*",
        "https://*.comeet.co/*",
        "https://*.jobs.personio.de/*",
        "https://*.jobs.personio.com/*",
        "https://jobs.gem.com/*",
        "https://app.dover.com/*",
        "https://jobs.polymer.co/*",
        "https://app.trinethire.com/*",
        "https://*.freshteam.com/*",
        "https://careers.jobscore.com/*",
        "https://*.recruitingbypaycor.com/*",
        "https://*.pageuppeople.com/*",
        "https://*.tal.net/*"
      ],
      "js": [
        "config.js",
        "filler.js",
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
